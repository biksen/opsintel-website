# Copy to .env and fill in. NEVER commit the real .env.

# Where contact submissions are delivered, and the From shown on them.
CONTACT_TO=bikash.sen@opsintels.com
CONTACT_FROM=bikash.sen@opsintels.com

# SMTP relay. Example below is GoDaddy email; any provider works (Amazon SES, Brevo,
# Mailgun, ...). Port 465 = SSL, 587 = STARTTLS.
# Put your real SMTP key here in the deployed .env only — never commit it.
SMTP_HOST=smtpout.secureserver.net
SMTP_PORT=465
SMTP_USER=you@opsintels.com
SMTP_PASSWORD=your-mailbox-password
SMTP_STARTTLS=true
