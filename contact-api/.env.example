# Copy to .env and fill in. NEVER commit the real .env.

# Where contact submissions are delivered, and the From shown on them.
CONTACT_TO=bikash.sen@opsintels.com
CONTACT_FROM=bikash.sen@opsintels.com

# SMTP relay. Example below is Brevo (free tier); any provider works (Amazon SES,
# Mailgun, Postmark, Gmail app password, ...). Port 587 = STARTTLS, 465 = SSL.
# Put your real SMTP key here in the deployed .env only — never commit it.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your-brevo-login@smtp-brevo.com
SMTP_PASSWORD=your-brevo-smtp-key
SMTP_STARTTLS=true
