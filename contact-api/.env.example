# Copy to .env and fill in. NEVER commit the real .env.

# Where contact submissions are delivered, and the From shown on them.
CONTACT_TO=bikash.sen@opsintels.com
CONTACT_FROM=no-reply@opsintels.com

# SMTP relay. Example below is Amazon SES SMTP (recommended on EC2); any provider
# works (Gmail app password, Mailgun, Postmark, ...). Port 587 = STARTTLS, 465 = SSL.
SMTP_HOST=email-smtp.us-east-1.amazonaws.com
SMTP_PORT=587
SMTP_USER=your-ses-smtp-username
SMTP_PASSWORD=your-ses-smtp-password
SMTP_STARTTLS=true
